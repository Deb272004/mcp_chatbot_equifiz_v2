# ─── Copy to .env and fill in real values ─────────────────────────────────────

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Allowed: groq | ollama | anthropic
LLM_PROVIDER=groq

# ─── Groq (default / development) ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Ollama (self-hosted / production) ───────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest

# ─── Anthropic (optional premium fallback) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── EQUIFIZ / CMOTS Live API ─────────────────────────────────────────────────
CMOTS_TOKEN=your_cmots_jwt_token_here
EQUIFIZ_TOKEN=your_cmots_jwt_token_here   # alias — same value

# ─── PostgreSQL (company master DB) ──────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=equifiz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ─── Redis (optional — enables cross-worker rate limiting) ────────────────────
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB persistence ─────────────────────────────────────────────────────
CHROMA_DIR=./chroma_store

# ─── Embedding model (fastembed) ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
FASTEMBED_CACHE=./.fastembed_cache

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Leave blank for guest/dev mode. Set to a secret string for simple API key auth.
API_SECRET_KEY=
# Path to Firebase service account JSON (enables per-user Firebase auth)
FIREBASE_CREDENTIALS=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Dev:  ALLOWED_ORIGINS=*
# Prod: ALLOWED_ORIGINS=https://equifiz.com,https://app.equifiz.com
ALLOWED_ORIGINS=*

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=30
RATE_LIMIT_VOICE=10

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ─── Chunking (tune if needed) ────────────────────────────────────────────────
STATIC_CHUNK_SIZE=700
STATIC_CHUNK_OVERLAP=100
LIVE_CHUNK_SIZE=300
LIVE_CHUNK_OVERLAP=50

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=./logs

# ─── Session DB (SQLite) ──────────────────────────────────────────────────────
SESSION_DB_PATH=./data/sessions.db
